# Cloudflare Pages 헤더 — 로컬 확인(dev/serve.mjs)도 이 파일을 그대로 읽어요
#  script-src: 이 사이트 파일만 (+ 배경 지우기 라이브러리가 만드는 blob 워커, WebAssembly)
#  글꼴은 이 사이트의 /fonts/(JL Sans = Pretendard 줄인 판, dev/fonts.mjs) — 이름에 내용 해시가 붙어 1년 캐시. sw.js 는 늘 새로 확인(no-cache)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' blob: https://staticimgly.com; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 화면 JS(Vite 가 이름에 내용 해시)와 CSS(sw-plugin hashStyles 가 style.<해시>.css 로 바꿔요)도 이름이 바뀌지 않으면 내용도 그대로라 1년 캐시(QA 12바퀴).
# 예전에는 max-age=0 이라 다시 열 때마다·서비스 워커가 미리 저장할 때마다 서버에 다시 물었어요. dist/css 에는 해시 붙은 파일만 있어요
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# 아이콘·공유 그림은 이름에 해시가 없어서 하루만(다시 열 때마다 icon.svg 두 번·favicon.png 를 서버에 다시 물었어요, QA 12바퀴)
/assets/*
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache

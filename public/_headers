# Cloudflare Pages 헤더 — 로컬 확인(dev/serve.mjs)도 이 파일을 그대로 읽어요
#  script-src: 이 사이트 파일만 (+ 배경 지우기 라이브러리가 만드는 blob 워커, WebAssembly)
#  글꼴은 이 사이트의 /fonts/(JL Sans = Pretendard 줄인 판, dev/fonts.mjs) — 이름에 내용 해시가 붙어 1년 캐시. sw.js 는 늘 새로 확인(no-cache)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' blob: https://staticimgly.com; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
